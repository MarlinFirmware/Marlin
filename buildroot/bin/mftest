#!/usr/bin/env bash
#
#  mftest                  Select a test to apply and build
#  mftest -a [#]           Build the auto-detected environment
#  mftest -u [#]           Upload the auto-detected environment
#  mftest -tname -n# [-y]  Set config options and optionally build a test
#

# Helper functions
errout() { echo -e "\033[0;31m$1\033[0m" ; }
perror() { errout "$0: $1 -- $2" ; }
bugout() { ((DEBUG)) && echo -e "\033[0;32m$1\033[0m" ; }

# Ensure we are in root and PlatformIO is available
[[ -d Marlin/src ]] || { errout "Please 'cd' to the Marlin repo root." ; exit 1 ; }
command -v pio &>/dev/null || { errout "Make sure 'pio' is in your PATH." ; exit 1 ; }

usage() {
cat <<EOF
Usage: mftest [-a|--autobuild]
       mftest [-r|--rebuild]
       mftest [-s|--silent]
       mftest [-t|--env=<env|index>] [-n|--num=<num>] [-m|--make] [-y|--build=<Y|n>]
       mftest [-u|--autoupload] [-n|--num=<num>]

Optional arguments:
  -a --autobuild   PIO Build using MOTHERBOARD environment
  -d --default     Restore defaults before applying configs
  -h --help        Print this help
  -m --make        Use Make/Docker method
  -n --num         Test index number
  -r --rebuild     Rebuild previous build
  -s --silent      Silence PIO output
  -t --env         Environment to apply/run
  -u --autoupload  PIO Upload using MOTHERBOARD env
  -v --verbose     Debug output
  -y --build       Skip prompt and assume YES

env shortcuts: tree due esp lin lp8|lpc8 lp9|lpc9 m128 m256|mega stm|f1 f4 f7 s6 teensy|t31|t32 t35|t36 t40|t41
EOF
}

# Initial configuration
TESTPATH="buildroot/tests"
STATE_FILE="./.pio/.mftestrc"

shopt -s extglob nocasematch

# Matching patterns
ISNUM='^[0-9]+$'
ISRST='^(restore)_'
ISCMD='^(restore|opt|exec|use|pins|env)_'
ISEXEC='^exec_'
ISCONT='\\ *$'

# Get environment, test number, etc. from the command
TESTENV='-'
CHOICE=0
DEBUG=0

# Parse arguments
while getopts ':acdhmn:rst:uvy-:' OFLAG; do
  case "$OFLAG" in
    a) AUTO_BUILD=1 ; bugout "Auto-Build target..." ;;
    c) CLEAN_BUILD=1 ; bugout "Clean build..." ;;
    d) DL_DEFAULTS=1 ; bugout "Restore to defaults..." ;;
    h) EXIT_USAGE=1 ;;
    m) USE_MAKE=1 ; bugout "Using Make with Docker..." ;;
    n) [[ $OPTARG =~ $ISNUM ]] && { CHOICE="$OPTARG" ; bugout "Got a number: $CHOICE" ; } || { perror "option requires number" $OFLAG ; EXIT_USAGE=2 ; } ;;
    r) REBUILD=1         ; bugout "Rebuilding previous..." ;;
    s) SILENT_FLAG="-s" ;;
    t) TESTENV="$OPTARG" ; bugout "Got a target: $TESTENV" ;;
    u) AUTO_BUILD=2      ; bugout "Auto-Upload target..." ;;
    v) DEBUG=1           ; bugout "Debug ON" ;;
    y) BUILD_YES='Y'     ; bugout "Build will initiate..." ;;
    -)
      ONAM="${OPTARG%%=*}"
      OVAL="${OPTARG#*=}"
      case "$ONAM" in
        help) [[ -z $OVAL ]] || { perror "option can't take value $OVAL" $ONAM ; EXIT_USAGE=2 ; } ; EXIT_USAGE=1 ;;
    autobuild) AUTO_BUILD=1 ; bugout "Auto-Build target..."  ;;
   autoupload) AUTO_BUILD=2 ; bugout "Auto-Upload target..." ;;
        clean) CLEAN_BUILD=1 ; bugout "Clean build..." ;;
          env) [[ -z "$OVAL" ]] && { perror "option requires a value" $ONAM ; EXIT_USAGE=2 ; } || { TESTENV="$OVAL" ; bugout "Got a target: $TESTENV" ; } ;;
          num) [[ $OVAL =~ $ISNUM ]] && { CHOICE="$OVAL" ; bugout "Got a number: $CHOICE" ; } || { perror "option requires a number" $ONAM ; EXIT_USAGE=2 ; } ;;
      rebuild) REBUILD=1  ; bugout "Rebuilding previous..." ;;
       silent) SILENT_FLAG="-s" ;;
         make) USE_MAKE=1 ; bugout "Using Make with Docker..." ;;
debug|verbose) DEBUG=1    ; bugout "Debug ON" ;;
      default) DL_DEFAULTS=1 ; bugout "Restore to defaults..." ;;
        build)
          case "$OVAL" in
            ''|y|yes) BUILD_YES='Y' ;;
                n|no) BUILD_YES='N' ;;
                   *) perror "option value must be y, n, yes, or no" $ONAM ; EXIT_USAGE=2 ;;
          esac
          bugout "Build will initiate? ($BUILD_YES)" ;;
            *) perror "Unknown value" "$OPTARG" ; EXIT_USAGE=2 ;;
      esac ;;

    :) perror "option requires an argument" "-$OPTARG" ; EXIT_USAGE=2 ;;
    ?) perror "Unknown flag" "-$OPTARG" ; EXIT_USAGE=2 ;;
  esac
done
shift $((OPTIND - 1))

((EXIT_USAGE)) && { usage ; let EXIT_USAGE-- ; exit $EXIT_USAGE ; }

# Handle rebuild
if ((REBUILD)); then
  bugout "Rebuilding previous..."
  [[ -f $STATE_FILE ]] || { errout "No previous (-r) build state found." ; exit 1 ; }
  read -r TESTENV <"$STATE_FILE"
  pio run ${SILENT_FLAG:-} -d . -e $TESTENV clean
  exit $? # Exit with the status of pio run
fi

if ((CLEAN_BUILD)); then
  bugout "Cleaning build env..."
  [[ -f $STATE_FILE ]] || { errout "No previous (-r) build state found." ; exit 1 ; }
  read -r TESTENV <"$STATE_FILE"
  pio run ${SILENT_FLAG:-} -d . -e $TESTENV -t clean
  exit $? # Exit with the status of pio run
fi

case $TESTENV in
      tree) pio run -d . -e include_tree ; exit 1 ;;
       due) TESTENV='DUE' ;;
       esp) TESTENV='esp32' ;;
      lin*) TESTENV='linux_native' ;;
  lp8|lpc8) TESTENV='LPC1768' ;;
  lp9|lpc9) TESTENV='LPC1769' ;;
      m128) TESTENV='mega1280' ;;
 m256|mega) TESTENV='mega2560' ;;
    stm|f1) TESTENV='STM32F103RE' ;;
        f4) TESTENV='STM32F4' ;;
        f7) TESTENV='STM32F7' ;;
        s6) TESTENV='STM32F446VE_fysetc' ;;
teensy|t31|t32) TESTENV='teensy31' ;;
   t35|t36) TESTENV='teensy35' ;;
   t40|t41) TESTENV='teensy41' ;;
[1-9]|[1-9][0-9]) TESTNUM=$TESTENV ; TESTENV='-' ;;
esac

if ((AUTO_BUILD)); then
  # List environments that apply to the current MOTHERBOARD
  case $(uname | tr '[:upper:]' '[:lower:]') in
    win*|msys*|cygwin*|mingw*) SYS='win' ;;
    darwin) SYS='mac' ;;
    *linux) SYS='lin' ;;
         *) SYS='uni' ;;
  esac
  echo ; echo -n "Auto " ; ((AUTO_BUILD == 2)) && echo "Upload..." || echo "Build..."

  # Get the MOTHERBOARD define value from the .h file and strip off the "BOARD_" prefix
  MB=$(awk '/^[[:space:]]*#define[[:space:]]MOTHERBOARD[[:space:]]/ { sub(/^BOARD_/, "", $3); print $3 }' Marlin/Configuration.h Marlin/Config.h 2>/dev/null | head -n1)
  [[ -z $MB ]] && { errout "Error - Can't read MOTHERBOARD setting." ; exit 1 ; }

  BLINE=$(grep -E "define\s+BOARD_$MB\b" Marlin/src/core/boards.h)
  BNUM=$(sed -E 's/^.+BOARD_[^ ]+ +([0-9]+).+$/\1/' <<<"$BLINE")
  BDESC=$(sed -E 's/^.+\/\/ *(.+)$/\1/' <<<"$BLINE")
  [[ -z $BNUM ]] && { errout "Error - Can't find BOARD_$MB in 'core/boards.h'." ; exit 1 ; }

  # Extract environments
  mapfile -t ENVS < <(
    grep -EA1 "MB\(.*\b$MB\b.*\)" Marlin/src/pins/pins.h |
    grep -E "#include.+//.+(env|$SYS):[^ ]+" |
    grep -oE "(env|$SYS):[^ ]+" |
    sed -E "s/(env|$SYS)://"
  )

  # If AUTO_BUILD is not 2 (upload), strip envs ending in '_xfer' from $ENVS
  if ((AUTO_BUILD != 2)); then
    ENVS=( $(printf "%s\n" "${ENVS[@]}" | grep -v "_xfer$") )
  fi

  if [[ ${#ENVS[@]} -eq 0 ]]; then
    errout "Error - Can't find target(s) for $MB ($BNUM)." ; exit 1 ;
  fi
  [[ -z $ENVS ]] && { errout "Error - Can't find target(s) for $MB ($BNUM)." ; exit 1 ; }

  ECOUNT=${#ENVS[@]}

  # Pick target
  if [[ $ECOUNT == 1 ]]; then
    TARGET="${ENVS[0]}"
  else
    if [[ $CHOICE == 0 ]]; then
      # List env names and numbers. Get selection.
      echo "Available targets for \"$BDESC\" | $MB ($BNUM):"

      IND=0 ; for ENV in "${ENVS[@]}"; do let IND++ ; echo " $IND) $ENV" ; done

      if [[ $ECOUNT > 1 ]]; then
        while :
        do
          read -p "Select a target for '$MB' (1-$ECOUNT) : " CHOICE
          [[ -z $CHOICE ]] && { errout "(canceled)" ; exit 1 ; }
          [[ $CHOICE =~ $ISNUM ]] && ((CHOICE >= 1 && CHOICE <= ECOUNT)) && break
          errout ">>> Invalid environment choice '$CHOICE'."
        done
        echo
      fi
    else
      echo "Detected \"$BDESC\" | $MB ($BNUM)."
      [[ $CHOICE -gt $ECOUNT ]] && { errout "Environment selection out of range." ; exit 66 ; }
    fi
    TARGET="${ENVS[$CHOICE-1]}"
    # Skip the linux_native environment
    [[ $MB == 'SIMULATED' && $TARGET == 'linux_native' ]] && TARGET="simulator_linux_release"
    echo "Selected $TARGET"
  fi

  echo "$TARGET" >"$STATE_FILE"
  if ((AUTO_BUILD == 2)); then
    echo "Uploading env $TARGET for board $MB ($BNUM)..." ; echo
    pio run ${SILENT_FLAG:-} -t upload -e $TARGET
  else
    echo "Building env $TARGET for board $MB ($BNUM)..." ; echo
    pio run ${SILENT_FLAG:-} -e $TARGET
  fi
  exit $?
fi

# Interactive test selection
if [[ $TESTENV == '-' ]]; then
  mapfile -t NAMES < <(ls -1 "$TESTPATH" | sort -f)
  IND=${#NAMES[@]}
  MENU=()
  BIGLEN=0
  for i in "${!NAMES[@]}"
  do
    ITEM=$(printf "%2i) %s" $((i + 1)) "${NAMES[i]}")
    MENU[i]=$ITEM
    ((${#ITEM} > BIGLEN)) && BIGLEN=${#ITEM}
  done

  ((BIGLEN += 2))
  THIRD=$(( (IND + 2) / 3 ))
  for ((i = 0; i < THIRD; i++))
  do
    printf "%-${BIGLEN}s%-${BIGLEN}s%-${BIGLEN}s\n" \
      "${MENU[i]}" \
      "${MENU[i + THIRD]:-}" \
      "${MENU[i + 2 * THIRD]:-}"
  done
  echo

  while :
  do
    if [[ $TESTNUM -gt 0 ]]; then
      NAMEIND=$TESTNUM
    else
      read -p "Select a test to apply (1-$IND) : " NAMEIND
    fi
    [[ -z $NAMEIND ]] && { errout "(canceled)" ; exit 1 ; }
    if [[ $NAMEIND =~ $ISNUM ]] && ((NAMEIND >= 1 && NAMEIND <= IND)); then
      TESTENV="${NAMES[$((NAMEIND-1))]}"
      [[ $TESTNUM -gt 0 ]] && { echo "Preselected test $TESTNUM ... ($TESTENV)" ; TESTNUM='' ; }
      echo
      break
    fi

    errout "Invalid selection."
    [[ $TESTNUM -gt 0 ]] && TESTNUM=''
  done
fi

# Load test file
OUT=$(<"$TESTPATH/$TESTENV") || { errout "Can't find test '$TESTENV'." ; exit 1 ; }

# Count up the number of tests
TESTCOUNT=$(grep -c "$ISEXEC" <<<"$OUT")
(( CHOICE < 0 || CHOICE > TESTCOUNT )) && { errout "Invalid test #$CHOICE (1-$TESTCOUNT)." ; exit 1 ; }

# List test descriptions with numbers and get selection
if [[ $CHOICE == 0 ]]; then
  echo "Available '$TESTENV' tests:"
  IND=0
  while IFS= read -r LINE
  do
    if [[ $LINE =~ $ISEXEC ]]; then
      ((IND++))
      DESC=$(sed -E 's/^exec_test \$1 \$2 "([^"]+)".*$/\1/' <<<"$LINE")
      printf " %2d) %s\n" "$IND" "$DESC"
    fi
  done <<<"$OUT"
  while :
  do
    read -p "Select test (1-$TESTCOUNT): " CHOICE
    [[ -z $CHOICE ]] && { errout "(canceled)" ; exit 1 ; }
    [[ $CHOICE =~ $ISNUM ]] && ((CHOICE >= 1 && CHOICE <= TESTCOUNT)) && break
    errout ">>> Invalid test selection '$CHOICE'."
  done
fi

# Restore defaults if requested
((DL_DEFAULTS)) && use_example_configs

# Execute selected test
echo -ne "\033[0;33m"
echo "$OUT" | {
  IND=0
  GOTX=0
  CMD=""
  while IFS= read -r LINE
  do
    if [[ $LINE =~ $ISCMD || $GOTX == 1 ]]; then
      ((!IND)) && let IND++
      if [[ $LINE =~ $ISEXEC ]]; then
        ((IND++ > CHOICE)) && break
      elif ((IND == CHOICE)); then
        if ! ((HEADER)); then
          HEADER=1
          echo -e "\n#\n# Test $TESTENV ($CHOICE): $DESC\n#"
          GOTX=1
        fi

        [[ -n $DL_DEFAULTS && $LINE =~ $ISRST ]] && LINE="use_example_configs"
        [[ $CMD == "" ]] && CMD="$LINE" || CMD=$( echo -e "$CMD$LINE" | sed -e 's/\\//g' | sed -E 's/ +/ /g' )
        [[ $LINE =~ $ISCONT ]] || { echo "$CMD" ; eval "$CMD" ; CMD="" ; }
      fi
    fi
  done
}
echo -ne "\033[0m"

# Make clear it's a TEST
opt_set CUSTOM_MACHINE_NAME "\"Test $TESTENV ($CHOICE)\""

# Build if requested
if [[ -z $BUILD_YES ]]; then
  echo
  read -p "Build $TESTENV test #$CHOICE (y/N)? " BUILD_YES
fi

[[ $BUILD_YES =~ ^(Y|Yes)$ ]] && {
  ((USE_MAKE)) && make tests-single-local TEST_TARGET=$TESTENV ONLY_TEST=$CHOICE
  ((USE_MAKE)) || pio run ${SILENT_FLAG:-} -d . -e $TESTENV
  echo "$TESTENV" >"$STATE_FILE"
}
